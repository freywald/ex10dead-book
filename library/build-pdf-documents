#!/bin/bash

source -- "./$LIBRARY_EX10DEAD_BOOK_PATH/library/utilities/utilities" || exit 1

# configuration start

# configuration end

function local_exit_failsafe() { __exit_failsafe; exit 1; }

# script task start

force_overwrite=false

function build_pdf() {
	source -- "Build/libraries/build-base" || exit 1

	force_overwrite=false
	build_for_language=""
	configuration_files=()

	local -a arguments=()
	while (($# > 0 )); do
		if [[ "$1" == "--finalize" ]]; then
			: #@todo
			shift ||__expression_may_fail
		elif [[ "$1" == "--configuration-file" ]]; then
			if [[ -z "${2-}" ]]; then
				__error "--configuration-file requires a path"
				local_exit_failsafe
			fi
			configuration_files+=("$2")
			shift 2 ||__expression_may_fail
		elif [[ "$1" == "--configuration-file="* ]]; then
			if [[ -z "${1#--configuration-file=}" ]]; then
				__error "--configuration-file requires a path"
				local_exit_failsafe
			fi
			configuration_files+=("${1#--configuration-file=}")
			shift ||__expression_may_fail
		elif [[ "$1" == "--build-for-language" ]]; then
			if [[ -z "${2-}" ]]; then
				__error "--build-for-language requires a language"
				local_exit_failsafe
			fi
			build_for_language="$2"
			shift 2 ||__expression_may_fail
		elif [[ "$1" == "--build-for-language="* ]]; then
			if [[ -z "${1#--build-for-language=}" ]]; then
				__error "--build-for-language requires a language"
				local_exit_failsafe
			fi
			build_for_language="${1#--build-for-language=}"
			shift ||__expression_may_fail
		elif [[ "$1" == "--force" || "$1" == "--force-overwrite" ]]; then
			force_overwrite=true
			shift ||__expression_may_fail
		else
			arguments+=("$1")
			shift ||__expression_may_fail
		fi
	done

	set -- "${arguments[@]}"

	if (($# > 0)); then
		__error "unknown program arguments: %s" "$@"
		local_exit_failsafe
	fi

	if [[ -z "$build_for_language" ]]; then
		__error "argument --build-for-language= is missing"
		local_exit_failsafe
	fi

	local default_configuration_file
	default_configuration_file="$LIBRARY_EX10DEAD_BOOK_PATH/configuration/defaults.yaml"
	if [[ ! -f "$default_configuration_file" ]]; then
		__error "default configuration file not found: %s" "$default_configuration_file"
		local_exit_failsafe
	fi

	__verbose "loading configuration file %s" "$default_configuration_file"
	load_configuration_file "$default_configuration_file"

	local configuration_file
	for configuration_file in "${configuration_files[@]}"; do
		__verbose "loading configuration file %s" "$configuration_file"
		if [[ ! -f "$configuration_file" ]]; then
			__error "configuration file %s does not exist" "$configuration_file"
			local_exit_failsafe
		fi
		load_configuration_file "$configuration_file"
	done

	if [[ -z "$temporary_directory" || ! -d "$temporary_directory" || ! -f "$temporary_directory/TEMPORARY_DIRECTORY__FILES_WILL_BE_DELETED_HERE" ]]; then
		__error "temporary directory must exist, flag file TEMPORARY_DIRECTORY__FILES_WILL_BE_DELETED_HERE must exist and configuration path cannot be empty. Value: %s" "$temporary_directory"
		local_exit_failsafe
	fi

	# unit conversion
	mm_per_inch="25.4"
	points_per_inch="72"
	points_per_mm="$(bc <<< "scale=10; $points_per_inch / $mm_per_inch")"   # ≈ 2.8346456693

	# scale factor from A4 page to the target print size
	scale_factor="$(bc <<< "scale=6; $target_print_width_mm / $page_width_mm")"

	# A4 page in pixels at the display resolution (used for the early input check)
	a4_page_width_px="$(bc <<< "scale=0; ($page_width_mm / $mm_per_inch) * $target_print_dpi")"
	a4_page_height_px="$(bc <<< "scale=0; ($page_height_mm / $mm_per_inch) * $target_print_dpi")"

	# allow a little undersize (90 %) so slightly cropped or compressed images still count
	a4_size_x="$(bc <<< "scale=0; $a4_page_width_px * 90 / 100")"
	a4_size_y="$(bc <<< "scale=0; $a4_page_height_px * 90 / 100")"
	a4_area_threshold="$(bc <<< "scale=0; $a4_page_width_px * $a4_page_height_px * 80 / 100")"

	# full-page image size at the target print resolution (used for the final PDF/X check)
	# Ghostscript -r1200 on an A4 page produces images of this order when rasterizing
	a0_page_width_px="$(bc <<< "scale=0; ($page_width_mm / $mm_per_inch) * $target_print_dpi * $scale_factor")"
	a0_page_height_px="$(bc <<< "scale=0; ($page_height_mm / $mm_per_inch) * $target_print_dpi * $scale_factor")"

	a0_size_x="$(bc <<< "scale=0; $a0_page_width_px * 90 / 100")"
	a0_size_y="$(bc <<< "scale=0; $a0_page_height_px * 90 / 100")"
	a0_area_threshold="$(bc <<< "scale=0; $a0_page_width_px * $a0_page_height_px * 80 / 100")"

	load_translations "$build_for_language"
	setup_build_variables

	pdf_language_name="$(translate_token "Screen reading version")"
	temporary_directory="$temporary_directory/language-$build_for_language/date-$__current_date"

	__info "[%s] building pdf documents︎…" "__$__current_script_name"

	__heading "INPUT RASTERIZATION"

	pdf_file_to_verify="$build_print_pdf_input_file"

	# pdfimages --list columns: $1 = page, $4 = width, $5 = height
	#pdfimages -list -- "$pdf_file_to_verify" 2>&1 | grep -v -- "Syntax Warning: Could not parse ligature component" | grep -v -- "^---" | tail -n +3 # removed,  because
	# 151    41 image    1884  4393  cmyk    4   8  jpeg   no      9311  0   455   440 2727K 8.4%
	# 151    42 image     942  2353  cmyk    4   8  jpeg   no     10803  0   455   414  888K  10%
	# 151    43 image     377  1129  cmyk    4   8  jpeg   no     10018  0   455   366  202K  12%
	#  produced result: "42 image     942  2353  cmyk    4   8  jpeg   no     10803  0   455   414  888K  10%"

	pdfimages --list -- "$build_print_pdf_input_file" 2>"/dev/null" | grep --invert-match -- "^---" | tail --lines=+3 ||__expression_may_fail

	possible_rasterization_images="$(pdfimages --list -- "$build_print_pdf_input_file" 2>"/dev/null" | grep --invert-match -- "^---" | tail --lines=+3 | awk '
		{ count[$1]++; if (( $4 > '"$a4_size_x"' && $5 > '"$a4_size_y"' ) || ( $4*$5 > '"$a4_area_threshold"' )) large[$1] = $4 "×" $5 }
		END {
		  for (p in count) {
			if (count[p] == 1 && large[p] != "") {
			  print p ": SINGLE LARGE IMAGE " large[p] " px → full-page rasterization likely"
			}
		  }
		}' | sort --numeric-sort)" || possible_rasterization_images=""

	if [[ -n "$possible_rasterization_images" ]]; then
		count_elements="$(echo "$possible_rasterization_images" | wc --lines)"
		__warn "Failed PDF/X conversion!"
		__info "%s full-page rasterization candidates found. Possibly full-page rasterization was used. The output PDF may thus be impaired by text boldness artifacts due to PDF/X-1a rasterization, triggered by transparent PNG alpha channels." "$count_elements"
		echo -e "$possible_rasterization_images"
		# don't exit 1, it's only a heuristic that can fail!
	fi

	# Cleanup on exit
	cleanup() {
		[[ -d "$temporary_directory/" ]] && rm --recursive --force -- "$temporary_directory/"
	}

	trap "cleanup" "EXIT"

	mkdir --parents -- "$temporary_directory/"

	if [[ ! -f "$LIBRARY_EX10DEAD_BOOK_PATH/scripts/ghostscript/PDFX_def.ps" ]]; then
		__error "The file %s is required for continuing. Possibly, you can source it from '/usr/share/ghostscript/?/lib/PDFX_def.ps'." "$LIBRARY_EX10DEAD_BOOK_PATH/scripts/ghostscript/PDFX_def.ps"
		local_exit_failsafe
	fi

	__heading "ALPHA CHANNEL / TRANSPARENCY TEST"

	# Pre-check for anything that forces Ghostscript to rasterize the whole page
	# (required because PDF/X-1a forbids transparency and wir-machen-druck explicitly demands it)
	if ! $debug_skip_alpha_channels_check; then
		qpdf --qdf -- "$build_print_pdf_input_file" "$temporary_directory/grep-SMask.qdf"
		count_elements="$(
		  grep --text --extended-regexp --count \
			--regexp='/SMask[[:space:]]' \
			--regexp='/S[[:space:]]*/Transparency' \
			--regexp='/BM[[:space:]]*/(Multiply|Screen|Overlay|Darken|Lighten|ColorDodge|ColorBurn|HardLight|SoftLight|Difference|Exclusion|Hue|Saturation|Color|Luminosity)' \
			--regexp='/[Cc][Aa][[:space:]]+0*(\.[0-9]+|[0-9]*\.[0-9]+)' \
			--regexp='/ImageMask[[:space:]]+true' \
			"$temporary_directory/grep-SMask.qdf" \
		  || echo 0
		)"

		if (( count_elements > 0 )); then
			__error "Aborting PDF/X conversion. %s potential alpha/transparency elements found, which will cause full-page rasterization and text boldness artifacts in PDF/X-1a." "$count_elements"
			local_exit_failsafe
		fi

		__info "No alpha/transparency detected → proceeding safely."
	else
		__info "Alpha/transparency detection disabled → proceeding…"
		echo
	fi

	# Calculate expected A4 trim in points (with high precision)
	page_width_in_pt="$(bc <<< "scale=33; $page_width_mm * $points_per_mm")"
	page_height_in_pt="$(bc <<< "scale=33; $page_height_mm * $points_per_mm")"
	bleed_in_pt="$(bc <<< "scale=33; $expected_bleed_in_mm * $points_per_mm")"

	# Calculate bleed-extended size for output PDF
	page_width_with_bleed_in_pt="$(bc <<< "scale=33; ($page_width_mm + ($expected_bleed_in_mm * 2)) * $points_per_mm")"
	page_height_with_bleed_in_pt="$(bc <<< "scale=33; ($page_height_mm + ($expected_bleed_in_mm * 2)) * $points_per_mm")"

	echo -e "Expected A4 trim:\t$page_width_in_pt × $page_height_in_pt pt"
	echo -e "With $expected_bleed_in_mm mm bleed:\t$page_width_with_bleed_in_pt × $page_height_with_bleed_in_pt pt"
	echo

	# ──────────────────────────────────────────────────────────────────────────────
	# Get basic document info
	# ──────────────────────────────────────────────────────────────────────────────
	pdfinfo_output=""
	pdfinfo_exit=0
	pdfinfo_output="$(pdfinfo -- "$build_print_pdf_input_file" 2>"/dev/null")" || pdfinfo_exit=$?

	if (( pdfinfo_exit != 0 )); then
		__error "pdfinfo failed (exit code %s) – could not read %s. Possible issues: invalid PDF, file not found, or permissions error." "$pdfinfo_exit" "$build_print_pdf_input_file"
		local_exit_failsafe
	fi

	# If success, extract total_pages
	total_pages="$(echo "$pdfinfo_output" | grep -i -- '^Pages:' | awk '{print $2}')" || total_pages=""

	# Fallback: Missing/invalid pages line despite success
	if [[ -z "$total_pages" || ! "$total_pages" =~ ^[0-9]+$ ]]; then
		__error "pdfinfo succeeded but no valid '^Pages:' found in output for %s." "$build_print_pdf_input_file"
		local_exit_failsafe
	fi

	__info "Input PDF: %s (total pages: %s)" "$build_print_pdf_input_file" "$total_pages"

	# Get actual page size from the already-captured pdfinfo output
	page_sizes="$(echo "$pdfinfo_output" | grep -i "Page size" | head --lines=1 | awk '{print $3 "x" $5}')" || page_sizes=""

	if [[ -z "$page_sizes" ]]; then
		__error "Could not read page size from PDF."
		local_exit_failsafe
	fi

	actual_width="$(echo "$page_sizes" | cut --delimiter='x' --fields=1)"
	actual_height="$(echo "$page_sizes" | cut --delimiter='x' --fields=2)"

	# Simple floating-point comparison with tolerance
	width_difference="$(bc <<< "define abs(x){if(x<0) return -x; return x} scale=6; abs($actual_width - $page_width_in_pt)")"
	height_difference="$(bc <<< "define abs(x){if(x<0) return -x; return x} scale=6; abs($actual_height - $page_height_in_pt)")"

	dont_add_extra_bleed=false
	if [[ $(bc <<< "$width_difference > $tolerance_pt") -eq 1 ]] || [[ $(bc <<< "$height_difference > $tolerance_pt") -eq 1 ]]; then
		__warn "Input PDF page size is %s pt — does NOT match A4 (%s × %s pt)" "$page_sizes" "$page_width_in_pt" "$page_height_in_pt"
		__info "Difference: width %s pt, height %s pt" "$width_difference" "$height_difference"
		__info "No need for ghostscript post-process bleed addition."
		# Input already contains bleed (or is non-standard). Use its actual size as the media box.
		# Assumption: the oversize equals exactly expected_bleed_in_mm on each side.
		page_width_with_bleed_in_pt="$actual_width"
		page_height_with_bleed_in_pt="$actual_height"
		dont_add_extra_bleed=true
	else
		__info "OK: input PDF page size %s pt matches A4 (within %s pt tolerance)." "$page_sizes" "$tolerance_pt"
	fi

	page_width_trimbox_pt="$(bc <<< "scale=33; $page_width_with_bleed_in_pt - ($bleed_in_pt*2) ")"
	page_height_trimbox_pt="$(bc <<< "scale=33; $page_height_with_bleed_in_pt - ($bleed_in_pt*2)")"

	echo
	pdfinfo -box "$build_print_pdf_input_file" | grep --extended-regexp 'MediaBox|CropBox|BleedBox|TrimBox|ArtBox' ||__expression_may_fail

	# ──────────────────────────────────────────────────────────────────────────────
	__heading "Stage: Copy inputs"

	if [[ ! -f "$build_print_pdf_input_file" ]]; then
		__error "print pdf input not found: %s" "$build_print_pdf_input_file"
		local_exit_failsafe
	fi
	if [[ ! -f "$cover_pdf_file" ]]; then
		__error "cover pdf not found: %s" "$cover_pdf_file"
		local_exit_failsafe
	fi
	if [[ ! -d "$partials_pdf_directory" ]]; then
		__error "partials directory not found: %s" "$partials_pdf_directory"
		local_exit_failsafe
	fi

	local q1="$partials_pdf_directory/Bibliography-Titles-$build_for_language.pdf"
	local q2="$partials_pdf_directory/Bibliography-References-$build_for_language.pdf"
	local q3="$partials_pdf_directory/Bibliography-Captions-$build_for_language.pdf"
	for f in "$q1" "$q2" "$q3"; do
		if [[ ! -f "$f" ]]; then
			__error "bibliography partial not found: %s" "$f"
			local_exit_failsafe
		fi
	done

	mkdir --parents -- "$(dirname -- "$build_print_pdf_result_cover")"
	mkdir --parents -- "$(dirname -- "$build_print_pdf_result_pdfa_with_cover")"
	mkdir --parents -- "$(dirname -- "$build_print_pdf_result_pdfa_without_cover")"
	mkdir --parents -- "$(dirname -- "$build_print_pdf_result_pdfx_with_cover")"
	mkdir --parents -- "$(dirname -- "$build_print_pdf_result_pdfx_without_cover")"

	input_basename="$(basename -- "$build_print_pdf_input_file")"

	cp -- "$build_print_pdf_input_file" "$temporary_directory/$input_basename.pdf"
	cp -- "$cover_pdf_file" "$partials_pdf_directory/Umschlag-$build_for_language.pdf"

	gs -q -dBATCH -dNOPAUSE -sDEVICE=pdfwrite -dPDFSETTINGS=/prepress -dEmbedAllFonts=true -dSubsetFonts=true -dCompressFonts=false -dCompatibilityLevel=1.4 -dFIXEDMEDIA -dDEVICEWIDTHPOINTS="$page_width_with_bleed_in_pt" -dDEVICEHEIGHTPOINTS="$page_height_with_bleed_in_pt" -sOutputFile="$temporary_directory/Umschlag0-$build_for_language.pdf" "$partials_pdf_directory/Umschlag-$build_for_language.pdf"

	gs -q -dBATCH -dNOPAUSE -sDEVICE=pdfwrite -dPDFSETTINGS=/prepress -dEmbedAllFonts=true -dSubsetFonts=true -dCompressFonts=false -dCompatibilityLevel=1.4 -sOutputFile="$temporary_directory/Umschlag-$build_for_language.pdf" "$temporary_directory/Umschlag0-$build_for_language.pdf"

	pdftk A="$temporary_directory/Umschlag-$build_for_language.pdf" Q="$partials_pdf_directory/Bibliography-Titles-$build_for_language.pdf" QQ="$partials_pdf_directory/Bibliography-References-$build_for_language.pdf" QQQ="$partials_pdf_directory/Bibliography-Captions-$build_for_language.pdf" H="$temporary_directory/$input_basename.pdf" cat A1 A2 H Q QQ QQQ A3-10 A13-14 output "$temporary_directory/with_cover-$build_for_language.pdf"

	pdftk A="$temporary_directory/Umschlag-$build_for_language.pdf" cat A1 A2 A12-13 output "$build_print_pdf_result_cover"

	add_bleed_ghostscript_file=""
	if ! $dont_add_extra_bleed; then
		add_bleed_ghostscript_file="$LIBRARY_EX10DEAD_BOOK_PATH/scripts/ghostscript/add_bleed.ps"
	fi

	# ──────────────────────────────────────────────────────────────────────────────
	__heading "Stage 0: variant PDF/A, without cover"

	gs -q -dBATCH -dNOPAUSE -sDEVICE=pdfwrite -dPDFSETTINGS=/prepress -dEmbedAllFonts=true -dSubsetFonts=true -dCompressFonts=false -dCompatibilityLevel=1.4 -dFIXEDMEDIA -dDEVICEWIDTHPOINTS="$page_width_with_bleed_in_pt" -dDEVICEHEIGHTPOINTS="$page_height_with_bleed_in_pt" -sOutputFile="$temporary_directory/PDFA_dirty_without_cover-$build_for_language.pdf" ${add_bleed_ghostscript_file:+"$add_bleed_ghostscript_file"} "$temporary_directory/$input_basename.pdf"

	qpdf_rc=0
	qpdf --qdf --object-streams=disable --compress-streams=n -- "$temporary_directory/PDFA_dirty_without_cover-$build_for_language.pdf" "$build_print_pdf_result_pdfa_without_cover" || qpdf_rc=$?
	if (( qpdf_rc != 0 && qpdf_rc != 3 )); then
		__error "qpdf failed with exit code %s" "$qpdf_rc"
		local_exit_failsafe
	fi

	exiftool -json="$metadata_file" -ModifyDate=now -overwrite_original "$build_print_pdf_result_pdfa_without_cover"

	# ──────────────────────────────────────────────────────────────────────────────
	__heading "Stage 0: variant PDF/A, with cover"
	gs -q -dBATCH -dNOPAUSE -sDEVICE=pdfwrite -dPDFSETTINGS=/prepress -dEmbedAllFonts=true -dSubsetFonts=true -dCompressFonts=false -dCompatibilityLevel=1.4 -dFIXEDMEDIA -dDEVICEWIDTHPOINTS="$page_width_with_bleed_in_pt" -dDEVICEHEIGHTPOINTS="$page_height_with_bleed_in_pt" -sOutputFile="$temporary_directory/PDFA_dirty_with_cover-$build_for_language.pdf" ${add_bleed_ghostscript_file:+"$add_bleed_ghostscript_file"} "$temporary_directory/with_cover-$build_for_language.pdf"

	qpdf_rc=0
	qpdf --qdf --object-streams=disable --compress-streams=n -- "$temporary_directory/PDFA_dirty_with_cover-$build_for_language.pdf" "$build_print_pdf_result_pdfa_with_cover" || qpdf_rc=$?
	if (( qpdf_rc != 0 && qpdf_rc != 3 )); then
		__error "qpdf failed with exit code %s" "$qpdf_rc"
		local_exit_failsafe
	fi

	exiftool -json="$metadata_file" -ModifyDate=now -overwrite_original "$build_print_pdf_result_pdfa_with_cover"

	# ──────────────────────────────────────────────────────────────────────────────
	cpdf -trimbox "${bleed_in_pt}pt ${bleed_in_pt}pt ${page_width_trimbox_pt}pt ${page_height_trimbox_pt}pt" "$build_print_pdf_result_pdfa_with_cover" AND -bleedbox "0 0 ${page_width_with_bleed_in_pt}pt ${page_height_with_bleed_in_pt}pt" -o "$temporary_directory/PDFA_trim_with_cover-$build_for_language.pdf"
	mv -- "$temporary_directory/PDFA_trim_with_cover-$build_for_language.pdf" "$build_print_pdf_result_pdfa_with_cover"
	pdfinfo -box "$build_print_pdf_result_pdfa_with_cover" | grep -i "box"

	cpdf -trimbox "${bleed_in_pt}pt ${bleed_in_pt}pt ${page_width_trimbox_pt}pt ${page_height_trimbox_pt}pt" "$build_print_pdf_result_pdfa_without_cover" AND -bleedbox "0 0 ${page_width_with_bleed_in_pt}pt ${page_height_with_bleed_in_pt}pt" -o "$temporary_directory/PDFA_trim_without_cover-$build_for_language.pdf"
	mv -- "$temporary_directory/PDFA_trim_without_cover-$build_for_language.pdf" "$build_print_pdf_result_pdfa_without_cover"
	pdfinfo -box "$build_print_pdf_result_pdfa_without_cover" | grep -i "box"

	cpdf -trimbox "${bleed_in_pt}pt ${bleed_in_pt}pt ${page_width_trimbox_pt}pt ${page_height_trimbox_pt}pt" "$build_print_pdf_result_pdfa_with_cover" AND -bleedbox "0 0 ${page_width_with_bleed_in_pt}pt ${page_height_with_bleed_in_pt}pt" AND -show-boxes -o "${build_print_pdf_result_pdfa_with_cover%.*} with visible boxes-$build_for_language.pdf"

	cpdf -trimbox "${bleed_in_pt}pt ${bleed_in_pt}pt ${page_width_trimbox_pt}pt ${page_height_trimbox_pt}pt" "$build_print_pdf_result_pdfa_without_cover" AND -bleedbox "0 0 ${page_width_with_bleed_in_pt}pt ${page_height_with_bleed_in_pt}pt" AND -show-boxes -o "${build_print_pdf_result_pdfa_without_cover%.*} with visible boxes-$build_for_language.pdf"

	# ──────────────────────────────────────────────────────────────────────────────
	__heading "1ST PASS: variant PDF/X, without cover, with embedded fonts"
	gs -q -dBATCH -dNOPAUSE -sDEVICE=pdfwrite -dPDFSETTINGS=/prepress -dEmbedAllFonts=true -dSubsetFonts=true -dCompressFonts=false -dCompatibilityLevel=1.4 -sOutputFile="$temporary_directory/pre_embed_1.4_without_cover-$build_for_language.pdf" "$temporary_directory/$input_basename.pdf"

	__heading "1ST PASS: variant PDF/X, with cover, with embedded fonts"
	gs -q -dBATCH -dNOPAUSE -sDEVICE=pdfwrite -dPDFSETTINGS=/prepress -dEmbedAllFonts=true -dSubsetFonts=true -dCompressFonts=false -dCompatibilityLevel=1.4 -sOutputFile="$temporary_directory/pre_embed_1.4_with_cover-$build_for_language.pdf" "$temporary_directory/with_cover-$build_for_language.pdf"

	# ──────────────────────────────────────────────────────────────────────────────
	__heading "2ND PASS: variant PDF/X, without cover, high resolution processing"

	printf '%%!\n/ICCProfile (%s) def\n' "$icc_profile" > "$temporary_directory/icc_path.ps"

	gs -q -r1200 -dPDFSETTINGS=/prepress -dPreserveAnnots=false -dEmbedAllFonts=true -dSubsetFonts=true -dCompressFonts=false -dPDFX=1 -dCompatibilityLevel=1.4 -dFIXEDMEDIA -dDEVICEWIDTHPOINTS="$page_width_with_bleed_in_pt" -dDEVICEHEIGHTPOINTS="$page_height_with_bleed_in_pt" -dBATCH -dNOPAUSE -sColorConversionStrategy=CMYK -sColorConversionStrategyForImages=CMYK -dProcessColorModel=/DeviceCMYK -sDefaultRGBProfile="$srgb_profile" -sOutputICCProfile="$icc_profile" -sDEVICE=pdfwrite -sOutputFile="$temporary_directory/X1A_dirty_without_cover-$build_for_language.pdf" --permit-file-read="$LIBRARY_EX10DEAD_BOOK_PATH/assets/color-profiles/ISOcoated_v2_300_eci.icc" "$LIBRARY_EX10DEAD_BOOK_PATH/scripts/ghostscript/never_embed_empty.ps" "$temporary_directory/icc_path.ps" "$LIBRARY_EX10DEAD_BOOK_PATH/scripts/ghostscript/PDFX_def.ps" ${add_bleed_ghostscript_file:+"$add_bleed_ghostscript_file"} "$temporary_directory/pre_embed_1.4_without_cover-$build_for_language.pdf"

	qpdf_rc=0
	qpdf --qdf --object-streams=disable --compress-streams=n -- "$temporary_directory/X1A_dirty_without_cover-$build_for_language.pdf" "$build_print_pdf_result_pdfx_without_cover" || qpdf_rc=$?
	if (( qpdf_rc != 0 && qpdf_rc != 3 )); then
		__error "qpdf failed with exit code %s" "$qpdf_rc"
		local_exit_failsafe
	fi

	exiftool -json="$metadata_file" -ModifyDate=now -overwrite_original "$build_print_pdf_result_pdfx_without_cover"

	__heading "2ND PASS: variant PDF/X, with cover, high resolution processing"
	gs -q -r1200 -dPDFSETTINGS=/prepress -dPreserveAnnots=false -dEmbedAllFonts=true -dSubsetFonts=true -dCompressFonts=false -dPDFX=1 -dCompatibilityLevel=1.4 -dFIXEDMEDIA -dDEVICEWIDTHPOINTS="$page_width_with_bleed_in_pt" -dDEVICEHEIGHTPOINTS="$page_height_with_bleed_in_pt" -dBATCH -dNOPAUSE -sColorConversionStrategy=CMYK -sColorConversionStrategyForImages=CMYK -dProcessColorModel=/DeviceCMYK -sDefaultRGBProfile="$srgb_profile" -sOutputICCProfile="$icc_profile" -sDEVICE=pdfwrite -sOutputFile="$temporary_directory/X1A_dirty_with_cover-$build_for_language.pdf" --permit-file-read="$LIBRARY_EX10DEAD_BOOK_PATH/assets/color-profiles/ISOcoated_v2_300_eci.icc" "$LIBRARY_EX10DEAD_BOOK_PATH/scripts/ghostscript/never_embed_empty.ps" "$temporary_directory/icc_path.ps" "$LIBRARY_EX10DEAD_BOOK_PATH/scripts/ghostscript/PDFX_def.ps" ${add_bleed_ghostscript_file:+"$add_bleed_ghostscript_file"} "$temporary_directory/pre_embed_1.4_with_cover-$build_for_language.pdf"

	qpdf_rc=0
	qpdf --qdf --object-streams=disable --compress-streams=n -- "$temporary_directory/X1A_dirty_with_cover-$build_for_language.pdf" "$build_print_pdf_result_pdfx_with_cover" || qpdf_rc=$?
	if (( qpdf_rc != 0 && qpdf_rc != 3 )); then
		__error "qpdf failed with exit code %s" "$qpdf_rc"
		local_exit_failsafe
	fi

	exiftool -json="$metadata_file" -ModifyDate=now -overwrite_original "$build_print_pdf_result_pdfx_with_cover"

	cpdf -trimbox "${bleed_in_pt}pt ${bleed_in_pt}pt ${page_width_trimbox_pt}pt ${page_height_trimbox_pt}pt" "$build_print_pdf_result_pdfx_with_cover" AND -bleedbox "0 0 ${page_width_with_bleed_in_pt}pt ${page_height_with_bleed_in_pt}pt" -o "$temporary_directory/X1A_trim_with_cover-$build_for_language.pdf"
	mv -- "$temporary_directory/X1A_trim_with_cover-$build_for_language.pdf" "$build_print_pdf_result_pdfx_with_cover"
	pdfinfo -box "$build_print_pdf_result_pdfx_with_cover" | grep -i "box"

	cpdf -trimbox "${bleed_in_pt}pt ${bleed_in_pt}pt ${page_width_trimbox_pt}pt ${page_height_trimbox_pt}pt" "$build_print_pdf_result_pdfx_without_cover" AND -bleedbox "0 0 ${page_width_with_bleed_in_pt}pt ${page_height_with_bleed_in_pt}pt" -o "$temporary_directory/X1A_trim_without_cover-$build_for_language.pdf"
	mv -- "$temporary_directory/X1A_trim_without_cover-$build_for_language.pdf" "$build_print_pdf_result_pdfx_without_cover"
	pdfinfo -box "$build_print_pdf_result_pdfx_without_cover" | grep -i "box"

	cpdf -trimbox "${bleed_in_pt}pt ${bleed_in_pt}pt ${page_width_trimbox_pt}pt ${page_height_trimbox_pt}pt" "$build_print_pdf_result_pdfx_with_cover" AND -bleedbox "0 0 ${page_width_with_bleed_in_pt}pt ${page_height_with_bleed_in_pt}pt" AND -show-boxes -o "${build_print_pdf_result_pdfx_with_cover%.*} with visible boxes-$build_for_language.pdf"

	cpdf -trimbox "${bleed_in_pt}pt ${bleed_in_pt}pt ${page_width_trimbox_pt}pt ${page_height_trimbox_pt}pt" "$build_print_pdf_result_pdfx_without_cover" AND -bleedbox "0 0 ${page_width_with_bleed_in_pt}pt ${page_height_with_bleed_in_pt}pt" AND -show-boxes -o "${build_print_pdf_result_pdfx_without_cover%.*} with visible boxes-$build_for_language.pdf"

	__replace_symlink --no-dereference --force --symbolic -- "../$build_print_pdf_result_pdfx_with_cover" "3. Ausfertigung/$PDF_NAME_STEM ($pdf_language_name).pdf"
	__replace_symlink --no-dereference --force --symbolic -- "$build_print_pdf_result_pdfx_with_cover" "$PDF_NAME_STEM ($pdf_language_name).pdf"

	pdf_file_to_verify="$build_print_pdf_result_pdfx_without_cover"

	# ──────────────────────────────────────────────────────────────────────────────
	echo
	echo
	echo
	echo
	echo
	echo
	echo
	echo
	echo

	__heading "VALIDATIONS"
	__info "File: %s" "$pdf_file_to_verify"
	echo
	echo

	__heading "1. structural check"
	check_output=$(qpdf --check "$pdf_file_to_verify" 2>&1 | grep --invert-match --null-data --perl-regexp "No syntax or stream encoding errors found; the file may still contain\serrors that qpdf cannot detect") || check_output=""
	if [[ -z "$check_output" ]]; then
		__info "OK – no detectable structural errors"
	else
		echo -e "WARNING / ERROR from qpdf:\n $check_output"
	fi

	echo
	echo

	__heading "2. pdf summary (PDF/X subtype, version, fonts, etc.)"
	pdfinfo -- "$pdf_file_to_verify" ||__expression_may_fail
	echo
	echo

	__heading "3. all fonts embedded?"
	pdffonts -- "$pdf_file_to_verify" 2>&1 | grep --invert-match -- "Syntax Warning: Could not parse ligature component" | grep --invert-match -- "^---" | grep --invert-match -- "name.*type" | awk '{print $1, $3}' | sort --unique ||__expression_may_fail
	echo
	echo

	__heading "4. check for trailer & linearization status"
	mutool info -- "$pdf_file_to_verify" | grep --extended-regexp -- "PDF-|Linearized|Pages" ||__expression_may_fail
	echo
	echo

	__heading "5. verapdf proxy check (PDF/A-1b – overlap with PDF/X)"
	verapdf --format text "$pdf_file_to_verify" || echo "verapdf: expected FAIL (normal for PDF/X vs PDF/A differences), but look for major errors on fonts/metadata."
	echo
	echo

	__heading "6. rasterization check (pages with single large image)"

	# pdfimages --list columns: $1 = page, $4 = width, $5 = height
	possible_rasterization_images="$(pdfimages --list -- "$pdf_file_to_verify" 2>&1 | grep --invert-match -- "Syntax Warning: Could not parse ligature component" | grep --invert-match -- "^---" | tail --lines=+3 | awk '
		{ count[$1]++; if (( $4 > '"$a0_size_x"' && $5 > '"$a0_size_y"' ) || ( $4*$5 > '"$a0_area_threshold"' )) large[$1] = $4 "×" $5 }
		END {
		  for (p in count) {
			if (count[p] == 1 && large[p] != "") {
			  print p ": SINGLE LARGE IMAGE " large[p] " px → full-page rasterization likely"
			}
		  }
		}' | sort --numeric-sort)" || possible_rasterization_images=""

	if [[ -n "$possible_rasterization_images" ]]; then
		count_elements="$(echo "$possible_rasterization_images" | wc --lines)"
		__warn "Detected a failed PDF/X conversion!"
		__info "%s full-page rasterization candidates found. Possibly full-page rasterization was used. The output PDF may thus be impaired by text boldness artifacts due to PDF/X-1a rasterization, triggered by transparent PNG alpha channels." "$count_elements"
		echo -e "$possible_rasterization_images"
	fi

	__info "Validation finished."
	__info "If pdfinfo shows PDF/X-1a subtype, pdffonts shows all fonts embedded, and no large single images → ready for print."
	__info "If rasterization pages appear → text may be bolder on those pages (unavoidable in PDF/X-1a with transparency)."

	echo
	echo
	__info "Done. Final file: %s" "$pdf_file_to_verify"

	[[ -d "$temporary_directory/" ]] && rm --recursive --force -- "$temporary_directory/"

	__info "[%s] done." "__$__current_script_name"
}
